#!/usr/bin/env bash
set -u
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_DIR="$APP_DIR/.app_runtime"
LOG_FILE="/tmp/slow_computer_rescue_open.log"
cd "$RUNTIME_DIR" || {
  echo "Could not find app runtime folder: $RUNTIME_DIR" >> "$LOG_FILE"
  exit 1
}
{
  echo "[$(date -Is)] Opening Slow Computer Rescue"
  exec ./Launch_Slow_Computer_Rescue "$@"
} >> "$LOG_FILE" 2>&1
